[
  {
    "id": 1,
    "title": "Автобус до Фазелиса",
    "level": "A1",
    "lines": [
      {
        "speaker": "Siz",
        "tr": "Bu otobüs Phaselis'e gidiyor mu?",
        "ru": "Этот автобус идёт в Фазелис?"
      },
      {
        "speaker": "Şoför",
        "tr": "Evet.",
        "ru": "Да."
      }
    ]
  },
  {
    "id": 2,
    "title": "Остановка в Фазелисе",
    "level": "A1",
    "lines": [
      {
        "speaker": "Siz",
        "tr": "Phaselis'te duruyor mu?",
        "ru": "Он останавливается в Фазелисе?"
      },
      {
        "speaker": "Şoför",
        "tr": "Evet.",
        "ru": "Да."
      }
    ]
  },
  {
    "id": 3,
    "title": "Скажите, где выйти",
    "level": "A1",
    "lines": [
      {
        "speaker": "Siz",
        "tr": "Phaselis'te ineceğim. Bana söyler misiniz?",
        "ru": "Я выхожу в Фазелисе. Скажете мне?"
      },
      {
        "speaker": "Şoför",
        "tr": "Tabii.",
        "ru": "Конечно."
      }
    ]
  },
  {
    "id": 4,
    "title": "Это Фазелис?",
    "level": "A1",
    "lines": [
      {
        "speaker": "Siz",
        "tr": "Burası Phaselis mi?",
        "ru": "Это Фазелис?"
      },
      {
        "speaker": "Şoför",
        "tr": "Evet, burada inebilirsiniz.",
        "ru": "Да, можете выходить здесь."
      }
    ]
  },
  {
    "id": 5,
    "title": "Мне здесь выходить?",
    "level": "A1",
    "lines": [
      {
        "speaker": "Siz",
        "tr": "Burada mı ineceğim?",
        "ru": "Мне здесь выходить?"
      },
      {
        "speaker": "Şoför",
        "tr": "Evet.",
        "ru": "Да."
      }
    ]
  },
  {
    "id": 6,
    "title": "Сколько ещё ехать?",
    "level": "A1",
    "lines": [
      {
        "speaker": "Siz",
        "tr": "Phaselis'e daha ne kadar var?",
        "ru": "Сколько ещё ехать до Фазелиса?"
      },
      {
        "speaker": "Şoför",
        "tr": "On dakika.",
        "ru": "Десять минут."
      }
    ]
  },
  {
    "id": 7,
    "title": "Где остановка?",
    "level": "A1",
    "lines": [
      {
        "speaker": "Siz",
        "tr": "Otobüs durağı nerede?",
        "ru": "Где автобусная остановка?"
      },
      {
        "speaker": "Yerli",
        "tr": "Şurada.",
        "ru": "Вон там."
      }
    ]
  },
  {
    "id": 8,
    "title": "Стоимость и оплата",
    "level": "A1",
    "lines": [
      {
        "speaker": "Siz",
        "tr": "Phaselis'e ne kadar?",
        "ru": "Сколько до Фазелиса?"
      },
      {
        "speaker": "Şoför",
        "tr": "Kırk lira.",
        "ru": "Сорок лир."
      },
      {
        "speaker": "Siz",
        "tr": "Kartla ödeyebilir miyim?",
        "ru": "Можно оплатить картой?"
      },
      {
        "speaker": "Şoför",
        "tr": "Evet.",
        "ru": "Да."
      }
    ]
  },
  {
    "id": 9,
    "title": "Автобус в центр",
    "level": "A1",
    "lines": [
      {
        "speaker": "Siz",
        "tr": "Merkeze gidiyor mu?",
        "ru": "Этот автобус идёт в центр?"
      },
      {
        "speaker": "Şoför",
        "tr": "Evet.",
        "ru": "Да."
      }
    ]
  },
  {
    "id": 10,
    "title": "Я пропустил остановку",
    "level": "A2",
    "lines": [
      {
        "speaker": "Siz",
        "tr": "Durağımı kaçırdım.",
        "ru": "Я пропустил свою остановку."
      },
      {
        "speaker": "Şoför",
        "tr": "Bir sonraki durakta inin.",
        "ru": "Выходите на следующей остановке."
      }
    ]
  }
]
